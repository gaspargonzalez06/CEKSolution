# --- Copia este archivo a .env y ajusta los valores ---

# Base de datos (MariaDB / XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cek

# Seguridad (JWT)
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria
JWT_ALG=HS256
JWT_MINUTES=480

# Clave para cifrar las claves de los agentes (Fernet, base64 urlsafe 32 bytes).
# Generala con:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Usuario admin inicial (se crea al arrancar si no existe)
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# CORS (separados por coma, * = todos)
CORS_ORIGINS=*
